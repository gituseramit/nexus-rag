# ==========================================
# Nexus RAG — Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ==========================================

# ─── Database ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://nexus:nexus@postgres:5432/nexus_rag
POSTGRES_PASSWORD=nexus

# ─── Cache / Queue ────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Authentication ───────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── AI — LLM ─────────────────────────────
# OpenAI API key (required for embeddings + chat)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
# Alternatively use claude-3-5-sonnet-20241022

# ─── AI — Embeddings ──────────────────────
EMBEDDING_MODEL=text-embedding-3-small
# Alternatives: text-embedding-3-large, text-embedding-ada-002

# ─── AI — Re-ranking (optional) ───────────
# Leave blank to use free local cross-encoder fallback
COHERE_API_KEY=

# ─── File Storage ─────────────────────────
STORAGE_BACKEND=local
# For production S3:
# STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=50

# ─── AWS S3 (optional, for production) ────
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── CORS ─────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# ─── RAG Settings ─────────────────────────
TOP_K_RETRIEVAL=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
